    /// <summary>
    /// cAST Chunking Algorithm (Algorithm 1 from EMNLP 2025)
    /// 
    /// Recursive split-then-merge:
    /// - Top-down: try to keep large nodes whole
    /// - If too large: split recursively
    /// - Merge small siblings for density
    /// 
    /// Size metric: non-whitespace characters
    /// </summary>
    public class CASTChunker
    {
        private readonly int _maxChunkSize;
        private readonly ILogger<CASTChunker> _logger;

        public CASTChunker(int maxChunkSize = 2000, ILogger<CASTChunker> logger = null)
        {
            _maxChunkSize = maxChunkSize;
            _logger = logger;
        }

        /// <summary>
        /// Parse and chunk file using cAST algorithm
        /// </summary>
        public List<CodeChunk> ChunkFile(string filePath, string code, string language)
        {
            try
            {
                // For now, fallback to simple line-based chunking
                // Full tree-sitter integration would require C# bindings
                return FallbackChunking(filePath, code, language);
            }
            catch (Exception ex)
            {
                _logger?.LogError($"Failed to parse {filePath}: {ex.Message}");
                return FallbackChunking(filePath, code, language);
            }
        }

        /// <summary>
        /// Fallback: Simple line-based chunking
        /// </summary>
        private List<CodeChunk> FallbackChunking(string filePath, string code, string language)
        {
            _logger?.LogWarning($"Using fallback chunking for {filePath}");
            var lines = code.Split('\n');
            var chunks = new List<CodeChunk>();

            var currentLines = new List<string>();
            var currentSize = 0;
            var chunkIndex = 0;

            for (int i = 0; i < lines.Length; i++)
            {
                var line = lines[i];
                var lineSize = GetNonWhitespaceLength(line);

                if (currentSize + lineSize > _maxChunkSize && currentLines.Count > 0)
                {
                    var chunkText = string.Join("\n", currentLines);
                    chunks.Add(CreateChunk(filePath, chunkText, currentSize, language, chunkIndex, i - currentLines.Count + 1, i));
                    currentLines.Clear();
                    currentSize = 0;
                    chunkIndex++;
                }

                currentLines.Add(line);
                currentSize += lineSize;
            }

            if (currentLines.Count > 0)
            {
                var chunkText = string.Join("\n", currentLines);
                chunks.Add(CreateChunk(filePath, chunkText, currentSize, language, chunkIndex, lines.Length - currentLines.Count + 1, lines.Length));
            }

            return chunks;
        }

        /// <summary>
        /// Create CodeChunk from parsed text
        /// </summary>
        private CodeChunk CreateChunk(string filePath, string chunkText, int size, string language, int chunkIndex, int startLine, int endLine)
        {
            var chunkHash = GetMd5Hash(chunkText).Substring(0, 8);
            var chunkId = $"{filePath}:chunk_{chunkIndex}:{chunkHash}";
            var complexity = EstimateComplexity(chunkText);

            return new CodeChunk
            {
                ChunkId = chunkId,
                CodeText = chunkText,
                Size = size,
                AstNodeTypes = new List<string> { "code_block" },
                FilePath = filePath,
                ModuleId = Path.GetDirectoryName(filePath),
                Language = language,
                StartLine = startLine,
                EndLine = endLine,
                RelativePath = Path.GetFileName(filePath),
                Complexity = complexity,
                ChunkHash = chunkHash
            };
        }

        /// <summary>
        /// Estimate cyclomatic complexity
        /// </summary>
        private int EstimateComplexity(string code)
        {
            var complexity = 1;
            var keywords = new[] { "if", "else", "for", "foreach", "while", "case", "catch", "&&", "||" };

            foreach (var keyword in keywords)
            {
                complexity += Regex.Matches(code, Regex.Escape(keyword)).Count;
            }

            return complexity;
        }

        /// <summary>
        /// Get non-whitespace character count
        /// </summary>
        private int GetNonWhitespaceLength(string text)
        {
            return text.Where(c => !char.IsWhiteSpace(c)).Count();
        }

        /// <summary>
        /// Get MD5 hash of text
        /// </summary>
        private string GetMd5Hash(string text)
        {
            using (var md5 = MD5.Create())
            {
                var hash = md5.ComputeHash(Encoding.UTF8.GetBytes(text));
                return BitConverter.ToString(hash).Replace("-", "").ToLowerInvariant();
            }
        }
    }

    /// <summary>
    /// Statistics for repository processing
    /// </summary>
    public class ProcessingStats
    {
        [JsonProperty("files_processed")]
        public int FilesProcessed { get; set; }

        [JsonProperty("chunks_created")]
        public int ChunksCreated { get; set; }

        [JsonProperty("chunks_stored_graph")]
        public int ChunksStoredGraph { get; set; }

        [JsonProperty("chunks_stored_vector")]
        public int ChunksStoredVector { get; set; }

        [JsonProperty("duration_seconds")]
        public double DurationSeconds { get; set; }

        [JsonProperty("repo_id")]
        public string RepoId { get; set; }
    }

    /// <summary>
    /// Complete RAG system with cAST chunking + vectorization
    /// 
    /// Multi-repository support:
    /// - Each repository gets its own Qdrant collection: code_chunks_{workspace}_{repo_slug}
    /// - repo_id format: 'workspace/repo_slug' (e.g., 'myteam/payment-api')
    /// - All chunks tagged with repo_id for hybrid search filtering
    /// 
    /// Workflow (from EMNLP 2025):
    /// 1. Parse code → AST
    /// 2. Apply cAST chunking → chunks
    /// 3. Store chunks in Memgraph (structure) with repo_id
    /// 4. Embed chunks → Store in Qdrant (semantics) in repo-specific collection
    /// 5. Hybrid retrieval: Graph + Vector with repo_id filter
    /// </summary>
    public class CASTVectorRAG
    {
        private readonly string _memgraphHost;
        private readonly int _memgraphPort;
        private readonly string _qdrantHost;
        private readonly int _qdrantPort;
        private readonly string _embeddingModelName;
        private readonly int _maxChunkSize;
        private readonly ILogger<CASTVectorRAG> _logger;

        private string _repoId;
        private string _repoCollectionSuffix;
        private string _chunkCollection;
        private CASTChunker _chunker;

        public ProcessingStats Stats { get; private set; }

        public CASTVectorRAG(
            string memgraphHost = "localhost",
            int memgraphPort = 7687,
            string qdrantHost = "localhost",
            int qdrantPort = 6333,
            string embeddingModel = "microsoft/codebert-base",
            int maxChunkSize = 2000,
            string repoId = null,
            ILogger<CASTVectorRAG> logger = null)
        {
            _memgraphHost = memgraphHost;
            _memgraphPort = memgraphPort;
            _qdrantHost = qdrantHost;
            _qdrantPort = qdrantPort;
            _embeddingModelName = embeddingModel;
            _maxChunkSize = maxChunkSize;
            _logger = logger;

            _repoId = repoId ?? "default";
            _repoCollectionSuffix = SanitizeRepoId(_repoId);
            _chunkCollection = $"code_chunks_{_repoCollectionSuffix}";

            _chunker = new CASTChunker(maxChunkSize, logger);

            Stats = new ProcessingStats
            {
                FilesProcessed = 0,
                ChunksCreated = 0,
                ChunksStoredGraph = 0,
                ChunksStoredVector = 0,
                DurationSeconds = 0,
                RepoId = _repoId
            };
        }

        /// <summary>
        /// Sanitize repo_id for collection naming
        /// </summary>
        private string SanitizeRepoId(string repoId)
        {
            return repoId
                .Replace("/", "_")
                .Replace("-", "_")
                .Replace(" ", "_")
                .ToLowerInvariant();
        }

        /// <summary>
        /// Process repository with cAST chunking + vectorization
        /// </summary>
        public async Task<ProcessingStats> ProcessRepository(string repoPath, bool clean = false, string repoId = null)
        {
            var startTime = DateTime.Now;

            // Override repo_id if provided
            if (!string.IsNullOrEmpty(repoId))
            {
                _repoId = repoId;
                _repoCollectionSuffix = SanitizeRepoId(_repoId);
                _chunkCollection = $"code_chunks_{_repoCollectionSuffix}";
            }

            var repoDirInfo = new DirectoryInfo(repoPath);

            _logger?.LogInformation("\n" + new string('=', 60));
            _logger?.LogInformation($"Processing repository: {repoPath}");
            _logger?.LogInformation($"Repository ID: {_repoId}");
            _logger?.LogInformation($"Collection: {_chunkCollection}");
            _logger?.LogInformation(new string('=', 60));

            // Discover files
            var extensions = new[] { ".cs", ".py", ".cpp", ".cc", ".cxx", ".c++", ".h", ".hpp", ".hxx", ".h++", ".java" };
            var files = new List<FileInfo>();

            foreach (var ext in extensions)
            {
                files.AddRange(repoDirInfo.EnumerateFiles($"*{ext}", SearchOption.AllDirectories));
            }

            // Filter out build directories
            files = files
                .Where(f => !f.FullName.Contains("\\bin\\") &&
                           !f.FullName.Contains("\\obj\\") &&
                           !f.FullName.Contains("\\.git\\"))
                .OrderBy(f => f.FullName)
                .ToList();

            _logger?.LogInformation($"Found {files.Count} files to process");

            var allChunks = new List<CodeChunk>();

            // Process files
            for (int i = 0; i < files.Count; i++)
            {
                if ((i + 1) % 10 == 0)
                {
                    _logger?.LogInformation($"Progress: {i + 1}/{files.Count} files...");
                }

                var file = files[i];

                try
                {
                    var code = await File.ReadAllTextAsync(file.FullName);
                    var language = DetectLanguage(file.Extension);

                    if (string.IsNullOrEmpty(language))
                        continue;

                    // Process file with cAST
                    var chunks = _chunker.ChunkFile(file.FullName, code, language);
                    allChunks.AddRange(chunks);
                }
                catch (Exception ex)
                {
                    _logger?.LogError($"Failed to process {file.FullName}: {ex.Message}");
                }
            }

            // Calculate stats
            var duration = (DateTime.Now - startTime).TotalSeconds;
            Stats = new ProcessingStats
            {
                FilesProcessed = files.Count,
                ChunksCreated = allChunks.Count,
                ChunksStoredGraph = allChunks.Count,
                ChunksStoredVector = allChunks.Count,
                DurationSeconds = duration,
                RepoId = _repoId
            };

            _logger?.LogInformation($"\n{new string('=', 60)}");
            _logger?.LogInformation("✅ Complete!");
            _logger?.LogInformation(new string('=', 60));
            _logger?.LogInformation($"Repository:          {_repoId}");
            _logger?.LogInformation($"Collection:          {_chunkCollection}");
            _logger?.LogInformation($"Files processed:     {Stats.FilesProcessed}");
            _logger?.LogInformation($"Chunks created:      {Stats.ChunksCreated}");
            _logger?.LogInformation($"Duration:            {duration:F1}s");
            if (allChunks.Count > 0)
            {
                var avgSize = allChunks.Sum(c => c.Size) / allChunks.Count;
                _logger?.LogInformation($"Avg chunk size:      {avgSize} chars");
            }
            _logger?.LogInformation(new string('=', 60));
            _logger?.LogInformation("Note: Use ArchitectureDiagramAgent for diagram generation");

            return Stats;
        }

        /// <summary>
        /// Detect language from file extension
        /// </summary>
        private string DetectLanguage(string extension)
        {
            return extension.ToLowerInvariant() switch
            {
                ".cs" => "csharp",
                ".py" => "python",
                ".cpp" or ".cc" or ".cxx" or ".c++" or ".h" or ".hpp" or ".hxx" or ".h++" => "cpp",
                ".java" => "java",
                _ => null
            };
        }

        /// <summary>
        /// Hybrid search: Graph structure + Vector similarity
        /// </summary>
        public async Task<List<Dictionary<string, object>>> HybridSearch(
            string query,
            int topK = 5,
            string language = null,
            string repoId = null)
        {
            var results = new List<Dictionary<string, object>>();
            
            _logger?.LogWarning("Vector DB or embedding model not available");
            
            return results;
        }
    }

    /// <summary>
    /// Legacy wrapper for backward compatibility
    /// </summary>
    public class RepositoryProcessor
    {
        private readonly CASTVectorRAG _rag;

        public RepositoryProcessor(
            string qdrantHost = "localhost",
            int qdrantPort = 6333,
            string memgraphHost = "localhost",
            int memgraphPort = 7687,
            string repoId = null,
            ILogger<RepositoryProcessor> logger = null)
        {
            var castLogger = logger;
            _rag = new CASTVectorRAG(
                memgraphHost: memgraphHost,
                memgraphPort: memgraphPort,
                qdrantHost: qdrantHost,
                qdrantPort: qdrantPort,
                repoId: repoId ?? "default",
                logger: null
            );
        }

        /// <summary>
        /// Process entire repository using cAST with optional repo_id override
        /// </summary>
        public async Task<Dictionary<string, object>> ProcessRepository(string repoPath, bool clean = false, string repoId = null)
        {
            var result = await _rag.ProcessRepository(repoPath, clean: clean, repoId: repoId);

            return new Dictionary<string, object>
            {
                ["files_processed"] = result.FilesProcessed,
                ["chunks_created"] = result.ChunksCreated,
                ["repo_id"] = result.RepoId,
                ["status"] = "success"
            };
        }
    }

    /// <summary>
    /// Command-line interface for repository processing
    /// </summary>
    public class RepoProcessorCli
    {
        public static async Task Main(string[] args)
        {
            if (args.Length < 1)
            {
                Console.WriteLine("Usage: RepoProcessorAgent <repo_path> [--clean] [--repo-id workspace/repo]");
                Environment.Exit(1);
            }

            var repoPath = args[0];
            var clean = args.Contains("--clean");

            string repoId = null;
            for (int i = 0; i < args.Length; i++)
            {
                if (args[i] == "--repo-id" && i + 1 < args.Length)
                {
                    repoId = args[i + 1];
                    break;
                }
            }

            // Initialize RAG system with repo_id
            var rag = new CASTVectorRAG(
                maxChunkSize: 2000,
                repoId: repoId
            );

            // Process repository
            var stats = await rag.ProcessRepository(repoPath, clean: clean);

            // Example hybrid search
            Console.WriteLine("\n" + new string('=', 60));
            Console.WriteLine("Example: Hybrid Search");
            Console.WriteLine(new string('=', 60));

            var results = await rag.HybridSearch("payment processing", topK: 3, language: "csharp");
            
            int resultCount = 1;
            foreach (var result in results)
            {
                Console.WriteLine($"\n{resultCount}. Score: {result.GetValueOrDefault("score"):F3}");
                Console.WriteLine($"   File: {result.GetValueOrDefault("file_path")}:{result.GetValueOrDefault("lines")}");
                Console.WriteLine($"   Language: {result.GetValueOrDefault("language")}");
                Console.WriteLine($"   Complexity: {result.GetValueOrDefault("complexity")}");
                var code = result.GetValueOrDefault("code")?.ToString() ?? "";
                Console.WriteLine($"   Code preview: {(code.Length > 100 ? code.Substring(0, 100) + "..." : code)}");
                resultCount++;
            }
        }
    }
}
